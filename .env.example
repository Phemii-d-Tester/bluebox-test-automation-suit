# BlueBox E2E — environment configuration
# Copy this file to `.env` (gitignored) and fill in the values. NO secrets in this file.

# --- App base URLs ---
USER_APP_URL=https://user-app-bluebox-dev.azurewebsites.net
ADMIN_APP_URL=https://admin-app-bluebox-dev.azurewebsites.net

# --- Guest (user-app) test data ---
# A stable, seeded guest invite token. The guest landing lives at: ${USER_APP_URL}/invite/<token>
GUEST_INVITE_TOKEN=

# Name of a real guest on the invited event (needed to unlock the personalized
# seat / meal / RSVP views in later modules). The Guest Invite landing module
# does not require this.
GUEST_NAME=

# --- Admin (admin-app) credentials — used by later admin modules only ---
BLUEBOX_EMAIL=
BLUEBOX_PASSWORD=
